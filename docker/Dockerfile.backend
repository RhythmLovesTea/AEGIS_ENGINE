# =============================================================================
# AEGIS-Marine: Production Multi-Stage Backend Dockerfile (API Gateway)
# Base: Python 3.12-slim (Debian Bookworm) with GDAL, GEOS, PROJ & Cairo
# Adheres to: PRD Section 16, Architecture Section 9, Rule 6
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Build Dependencies & Wheels
# -----------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system build dependencies and C/C++ libraries for spatial compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment for build isolation
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install production Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt

# -----------------------------------------------------------------------------
# Stage 2: Production Minimal Runtime
# -----------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    ENVIRONMENT=production

# Install shared geospatial, PDF generation, and monitoring runtime libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin \
    libgdal32 \
    libgeos-c1v5 \
    libproj25 \
    libpq5 \
    curl \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-compiled virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv

# Create unprivileged production system user
RUN groupadd -g 1000 aegis && \
    useradd -u 1000 -g aegis -s /bin/bash -m -d /home/aegis aegis

# Create required runtime storage and log directories with proper permissions
RUN mkdir -p /app/data/dossiers /app/data/sar /app/data/ais /app/data/metocean /app/models/checkpoints && \
    chown -R aegis:aegis /app

# Copy application source code, models, and migrations
COPY --chown=aegis:aegis backend /app/backend
COPY --chown=aegis:aegis models /app/models
COPY --chown=aegis:aegis data /app/data
COPY --chown=aegis:aegis alembic.ini /app/alembic.ini
COPY --chown=aegis:aegis pyproject.toml /app/pyproject.toml

# Switch to non-root user
USER aegis

# Expose FastAPI HTTP Gateway port
EXPOSE 8000

# Container Liveness Healthcheck
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Production Entrypoint via Uvicorn
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--access-log"]
