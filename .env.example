# ==============================================================================
# AEGIS-Marine Platform — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL / PostGIS / TimescaleDB
# ------------------------------------------------------------------------------
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=aegis_password
POSTGRES_DB=aegis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aegis_user:aegis_password@localhost:5432/aegis_db
SYNC_DATABASE_URL=postgresql://aegis_user:aegis_password@localhost:5432/aegis_db

# ------------------------------------------------------------------------------
# Redis (Celery Broker & Result Store)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# MinIO Object Storage (S3 Compatible)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=aegis_minio_admin
MINIO_ROOT_PASSWORD=aegis_minio_secret
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=aegis-storage
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# Application & Security Settings
# ------------------------------------------------------------------------------
SECRET_KEY=dev-secret-key-change-in-production-aegis-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# External Met-Ocean & Earth Observation Feeds (Optional for offline fixtures)
# ------------------------------------------------------------------------------
COPERNICUS_CDSE_CLIENT_ID=
COPERNICUS_CDSE_CLIENT_SECRET=
CMEMS_USERNAME=
CMEMS_PASSWORD=
AISHUB_USERNAME=
